# R
.Rhistory
.RData
.Rproj.user/
*.Rproj
renv/library/
renv/staging/

# Raw/processed data (large, licensed, or regenerated by scripts)
data/raw/*
# One deliberate exception: the demand-side snapshot that anchors every
# published figure (as_of_date 2026-06-18). 12.5 KB, licensed CC BY 4.0 so
# redistribution with attribution is permitted, and without it the results
# cannot be reproduced or checked. See docs/decisions.md, 2026-09-09.
!data/raw/ercot_large_load/
data/raw/ercot_large_load/*
!data/raw/ercot_large_load/snapshot_2026-06-18/
# Intermediate stage outputs are regenerated by the pipeline and not committed,
# with one deliberate exception: tableau_final.csv is the documented handoff
# artifact between the R pipeline and the Tableau layer. Without it the specs in
# tableau/ cannot be followed by anyone who has not run the pipeline.
data/processed/*
!data/processed/tableau_final.csv

# Tableau
*.twbx
*.hyper

# Output (regenerated by pipeline; keep only curated exports intentionally)
# output/figures/ is deliberately COMMITTED -- docs/risk_score_sensitivity_interpretation.md
# and README.md reference the charts by name, so a reader must be able to see them
# without installing R. Regenerate with R/07_visualizations.R.
output/tables/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
*.swp
